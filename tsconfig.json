{
  "compilerOptions": {
    /* Visit https://aka.ms/tsconfig to read more about this file */
    /* Language and Environment */
    "target": "ES2024",
    "module": "commonjs",
    "rootDir": "./",
    "moduleResolution": "node16",
    "rewriteRelativeImportExtensions": false,
    "allowJs": true,
    "checkJs": true,
    "outDir": "./out",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}
